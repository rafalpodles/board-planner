# The only variable the app requires
MONGODB_URI=mongodb://localhost:27017/boardplanner

# Public URL used in notification and webhook links. Read at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origins the app is served from, comma-separated. Rejects cross-site writes.
# Required whenever COOKIE_ALLOW_INSECURE=1.
APP_ORIGIN=http://localhost:3000

# The one address this instance calls its own — read at runtime, unlike NEXT_PUBLIC_APP_URL, which
# is baked into the image and therefore never consulted for this. Required for the MCP endpoint, its
# two /.well-known documents and the PM agent's OAuth redirect_uri; those answer 500 without it
# rather than trusting a request header. Falls back to APP_ORIGIN only when that names exactly one
# origin — a list cannot say which entry is the public one. Must be an http(s) URL.
# PUBLIC_ORIGIN=https://board.example.com

# How many proxies append to X-Forwarded-For in front of this app. 0 (the default) ignores the
# header entirely, because with nothing in front of the app it is whatever the caller typed — and
# the failed-login throttle keys on it. Set it to 1 behind a single nginx/Caddy, 2 behind a CDN too.
# TRUSTED_PROXY_HOPS=1

# Set to 1 ONLY when the app is served over plain HTTP — the session cookie then drops Secure and
# the __Host- prefix, which is what lets a sibling subdomain shadow it. Left commented out on
# purpose: a copy of this file used for a TLS deployment must not silently downgrade the cookie.
# The app refuses to start if this is on while APP_ORIGIN is https.
# COOKIE_ALLOW_INSECURE=1

# AI task generation (optional)
OPENAI_API_KEY=sk-...

# PM agent (optional) — chat-driven project manager via OpenRouter
OPENROUTER_API_KEY=sk-or-...
PM_MODEL=moonshotai/kimi-k2.6
PM_DAILY_TURN_CAP=100
# Tokens per project per day; unset means no ceiling. The turn cap above is a RATE limit —
# one turn is up to 15 model round-trips — so this is the one expressed in what you are billed.
PM_DAILY_TOKEN_CAP=

# Encrypts stored GitHub/GitLab/Coda/MCP credentials at rest — 32 bytes, hex or base64.
# Generate with: openssl rand -hex 32
# Optional only in the sense that the app runs without it; those credentials then cannot be saved
# at all, and a key that is set but the wrong length stops the app from starting.
ENCRYPTION_KEY=

# Retired encryption keys, comma-separated, kept so a rotation can still read what they wrote.
# ENCRYPTION_KEYS_OLD=

# Signs outgoing webhook deliveries (optional) — receivers verify
# x-boardplanner-signature over "<timestamp>.<body>". Unset means deliveries go unsigned.
WEBHOOK_SIGNING_SECRET=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
